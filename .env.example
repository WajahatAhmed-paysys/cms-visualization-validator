# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values for your environment.
# .env is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# CMS backend API (NOT the SPA at :5175). Confirm the port with browser devtools
# on the login request; the source code defaults to 3090.
CMS_BASE_URL=http://10.10.80.18:3090

# Gold Lakehouse API
LAKEHOUSE_BASE_URL=http://10.10.80.19:8282

# Test account (staging/test only - never production)
CMS_USERNAME=<set-me>
CMS_PASSWORD=<set-me>

# Defaults
TENANT_ID=DEFAULT
GRANULARITY=month
ROLES=creditor,debtor
REQUEST_TIMEOUT_MS=35000
RUN_BUDGET_MS=180000
# Concurrency: 1-8. Lower is gentler on the shared Spark engine and avoids
# downstream timeouts (this environment is slow under parallel load).
CONCURRENCY=2

# Optional: pin the end-to-end id instead of deriving it from Alert Navigator
# E2E_ID=

# Optional: transaction-history / benford window (defaults to last 90 days)
# FROM_DATE=2026-08-12
# TO_DATE=2026-11-10

# Optional
TIME_RANGE=30d

# Data Verify tolerances
VERIFY_TOLERANCE=0.01
VERIFY_MONEY_TOLERANCE=0.01
VERIFY_PERCENT_TOLERANCE=0.01
